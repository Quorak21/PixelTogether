{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/frontend-ng/browser",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/room/:path*", "destination": "/index.html" },
    { "source": "/lobby/:path*", "destination": "/index.html" },
    { "source": "/game/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
